<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="189dp"
            android:layout_height="93dp"
            android:src="@drawable/download"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="15dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Connexion"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp" />

        <EditText
            android:id="@+id/nom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez votre nom"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_background"
            android:textColorHint="#666666" />

        <EditText
            android:id="@+id/numero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Votre numéro de téléphone (0612345678)"
            android:textSize="16sp"
            android:inputType="phone"
            android:maxLength="12"
            android:digits="0123456789"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_background"
            android:textColorHint="#666666" />

        <EditText
            android:id="@+id/gmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="foot48@gmail.com"
            android:textSize="16sp"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_background"
            android:textColorHint="#666666" />

        <EditText
            android:id="@+id/motdepasse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mot de passe"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:padding="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/edittext_background"
            android:textColorHint="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S'inscrire comme un : "
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/TypeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="120dp"
                android:minHeight="48dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/localisationLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:padding="16dp"
            android:background="@drawable/edittext_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Localisation du stade"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnChoisirLocalisation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Choisir sur la carte"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvLocalisationSelectionnee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aucune localisation sélectionnée"
                android:textSize="14sp"
                android:textColor="#666666"
                android:padding="12dp"
                android:background="#f5f5f5"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stadesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:padding="16dp"
            android:background="@drawable/edittext_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajouter un stade"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etNomStade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nom du stade"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="#f9f9f9" />

            <EditText
                android:id="@+id/etDescriptionLieu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Décrivez le lieu exact (ex: près de l'école...)"
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="5"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="#f9f9f9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etCapacite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Capacité"

                    android:textSize="14sp"
                    android:inputType="number"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="#f9f9f9" />

                <EditText
                    android:id="@+id/etPrix"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Prix/heure (DH)"
                    android:textSize="14sp"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:layout_marginStart="8dp"
                    android:background="#f9f9f9" />

            </LinearLayout>

            <Button
                android:id="@+id/importer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 Importer photos"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF" />

            <!-- Conteneur horizontal pour aimagesfficher plusieurs images -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/imagesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:padding="8dp" />

            </HorizontalScrollView>

            <Button
                android:id="@+id/btnAjouterStade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="➕ Ajouter ce stade"
                android:layout_marginTop="12dp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvStadesAjoutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stades ajoutés: 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="#E8F5E8" />

        </LinearLayout>

        <Button
            android:id="@+id/confirmer"
            android:layout_width="170dp"
            android:layout_height="53dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4CAF50"
            android:padding="16dp"
            android:text="S'inscrire"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>