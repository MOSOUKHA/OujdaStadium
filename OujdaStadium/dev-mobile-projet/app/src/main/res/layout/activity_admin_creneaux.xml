<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Configuration des horaires -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration des horaires"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Heure d'ouverture -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHeureOuverture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Heure d'ouverture (HH:MM)"
                android:inputType="time" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Heure de fermeture -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHeureFermeture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Heure de fermeture (HH:MM)"
                android:inputType="time" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Durée créneau -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDureeCreneau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Durée créneau (minutes)"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bouton Générer -->
        <Button
            android:id="@+id/btnGenererCreneaux"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Générer les créneaux"
            android:layout_marginBottom="16dp" />

        <!-- Liste des créneaux générés -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Créneaux générés"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCreneaux"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp" />

        <!-- Bouton Sauvegarder -->
        <Button
            android:id="@+id/btnSauvegarder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sauvegarder les créneaux"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>