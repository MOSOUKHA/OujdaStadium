<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nom du stade -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du stade"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNomStade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom du stade"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_background" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:textSize="16sp"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="5"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_background" />

        <!-- Capacité -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capacité"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etCapacite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Capacité"
            android:textSize="16sp"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_background" />

        <!-- Prix -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prix/heure (DH)"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Prix/heure"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_background" />

        <!-- Adresse -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adresse"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAdresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adresse"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_background" />

        <!-- Localisation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Localisation sur la carte"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnChoisirLocalisation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Choisir sur la carte"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvLocalisation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Localisation actuelle"
            android:textSize="12sp"
            android:textColor="#666666"
            android:padding="8dp"
            android:background="#f5f5f5"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>