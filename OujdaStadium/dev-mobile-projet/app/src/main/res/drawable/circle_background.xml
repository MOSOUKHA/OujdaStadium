<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Couleur de remplissage (fond vert clair) -->
    <solid android:color="#E8F5E9" />

    <!-- Bordure verte -->
    <stroke
        android:width="2dp"
        android:color="#4CAF50" />

    <!-- Optionnel: Ajouter un padding intérieur -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>